# Paths are relative to the repository root. ML uses existing local weights only.
DATA_DIR=data
DATABASE_PATH=data/meetings.sqlite3
FRONTEND_DIST=frontend/dist
PORT=8000
WHISPER_MODEL_PATH=models/whisper-large-v3
PYANNOTE_MODEL_PATH=models/speaker-diarization-community-1
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=qwen3:8b
# Pass these to the separate Ollama process; the backend does not launch it.
OLLAMA_HOST=127.0.0.1:11434
OLLAMA_NO_CLOUD=1
FFMPEG_PATH=ffmpeg
FFPROBE_PATH=ffprobe
# Windows example (forward slashes also work in .env):
# FFMPEG_PATH=C:/Tools/ffmpeg/bin/ffmpeg.exe
# FFPROBE_PATH=C:/Tools/ffmpeg/bin/ffprobe.exe
LIBREOFFICE_PATH=soffice
# Windows PDF example:
# LIBREOFFICE_PATH=C:/Program Files/LibreOffice/program/soffice.exe
# Linux / Docker: LIBREOFFICE_PATH=/usr/bin/soffice
HF_HUB_OFFLINE=1
TRANSFORMERS_OFFLINE=1
HF_HUB_DISABLE_TELEMETRY=1
HF_HUB_DISABLE_IMPLICIT_TOKEN=1
PYANNOTE_METRICS_ENABLED=false
OTEL_SDK_DISABLED=true

# Docker Compose host paths; distinct from paths inside the container.
# Directories must already exist. models/ollama must contain manifests and blobs.
CONTAINER_DATA_DIR=./data
CONTAINER_MODELS_DIR=./models
CONTAINER_UID=1000
CONTAINER_GID=1000
# Compose sets DOCKER_INTERNAL_NETWORK=1 and CONTAINER_SERVICE automatically.
# Do not enable the Docker-only bind/network policy for a host Python run.
# Internal Ollama address is fixed in compose.yaml: http://172.30.66.3:11434.
