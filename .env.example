# Paths are relative to the repository root. No ML models are loaded.
DATA_DIR=data
DATABASE_PATH=data/meetings.sqlite3
FRONTEND_DIST=frontend/dist
PORT=8000
WHISPER_MODEL_PATH=models/whisper-large-v3
PYANNOTE_MODEL_PATH=models/speaker-diarization-community-1
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=qwen3:8b
FFMPEG_PATH=ffmpeg
FFPROBE_PATH=ffprobe
# Windows example (forward slashes also work in .env):
# FFMPEG_PATH=C:/Tools/ffmpeg/bin/ffmpeg.exe
# FFPROBE_PATH=C:/Tools/ffmpeg/bin/ffprobe.exe
LIBREOFFICE_PATH=soffice
# Preparation only: accept pyannote conditions before downloading weights.
# Never use this token in the processing pipeline.
HF_TOKEN=
HF_HUB_OFFLINE=1
TRANSFORMERS_OFFLINE=1
